# Copy to /etc/techflow/app.env on EC2 and restrict access (chmod 600).
# Never commit the real file. Use a distinct, strong secret for production.
APP_IMAGE=000000000000.dkr.ecr.ap-southeast-1.amazonaws.com/techflow-web:replace-with-release-tag
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
MYSQL_DATABASE=tech_business_db
MYSQL_USER=techflow_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
DB_HOST=replace-with-private-rds-endpoint
DB_PORT=3306
LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh
# Keep product images private in S3; EC2 should use an instance role, not static AWS keys.
UPLOAD_STORAGE=s3
S3_BUCKET=replace-with-your-private-image-bucket
AWS_REGION=ap-southeast-2
